{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    "strict": true,
    // Load-bearing, not fastidious: the tenancy model depends on never
    // silently coercing an absent agent id or tenant into a usable value.
    // These make the refusal path impossible to forget rather than merely
    // conventional. See docs/why.md §"Fail closed, in the type system".
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,

    "declaration": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": ".",

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "*.config.ts"],
  "exclude": ["node_modules", "dist", "generated"]
}
