{
  "name": "almanac",
  "version": "0.1.0",
  "private": true,
  "description": "Almanac — a bootstrap toolkit for channel-scoped analytics bots: report catalog, config generator, and warehouse plugin",
  "type": "module",
  "engines": {
    "node": ">=22.22.3 <23 || >=24.15.0 <25 || >=25.9.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "leakcheck": "node infra/leakcheck.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run leakcheck && npm run build && npm run generate",
    "generate": "vite-node src/generator/cli.ts",
    "build": "tsc -p tsconfig.build.json && npm run build:plugin",
    "build:plugin": "esbuild src/plugin/index.ts --bundle --platform=node --format=esm --target=node22 --external:openclaw --external:snowflake-sdk --outfile=dist/plugin/index.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "esbuild": "^0.28.1",
    "eslint": "^9.17.0",
    "openclaw": "^2026.7.1-2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "cron-parser": "^5.7.0",
    "typebox": "^1.3.3",
    "yaml": "^2.9.0"
  },
  "optionalDependencies": {
    "snowflake-sdk": "^2.1.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/plugin/index.js"
    ]
  }
}
